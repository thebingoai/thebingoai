# Database
# Option 1: Supabase (recommended for community)
# Find your connection string in Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Direct connection for migrations (bypasses Supabase connection pooler):
# DATABASE_URL_DIRECT=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Option 2: Local PostgreSQL (auto-detected by start.sh from localhost URL)
# DATABASE_URL=postgresql://thebingo_user:thebingo_password@localhost:5432/thebingo
#
# Client-side connection pool (per process). Total connections can reach
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) x worker processes — keep under your
# pooler's max_client_conn.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# Seconds to wait for a free slot before raising TimeoutError. SQLAlchemy's
# default is 30, which turns contention into a pile-up rather than a fast 503.
# DB_POOL_TIMEOUT=5
# Pool pressure logging — off by default. Logs entry into overflow and any
# checkout held at least DB_POOL_TRACE_SLOW_MS.
# DB_POOL_TRACE=false
# DB_POOL_TRACE_SLOW_MS=1000

# Database Password Encryption
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DB_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY_44_CHARS

# LLM Providers
# Required — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional — only needed if using the Anthropic provider
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Default LLM settings
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=              # Optional: overrides provider-specific default
DEFAULT_LLM_TEMPERATURE=0.7

# LLM Provider-specific defaults
OPENAI_DEFAULT_MODEL=gpt-4o
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514
ANTHROPIC_DEFAULT_MAX_TOKENS=4096
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_REQUEST_TIMEOUT=120.0

# Layer-4 orchestrator response-quality judge
# A cheap classifier LLM that decides whether the orchestrator's final answer
# actually resolves the user's question. On "unresolved", the orchestrator
# retries once; if still unresolved, the turn's credit is voided and the
# failure is captured into agent_failure_case for team review.
JUDGE_LLM_PROVIDER=openai          # or anthropic / ollama; empty → falls back to DEFAULT_LLM_PROVIDER
JUDGE_LLM_MODEL=gpt-5-mini         # recommended cheap classifier; empty → judge disabled (falls open)
JUDGE_TIMEOUT_SECONDS=10
JUDGE_ENABLED=true                 # kill-switch for the whole layer
JUDGE_HIGHLIGHT_ENABLED=true       # wrap meaningful numbers in ==...== so frontend renders them in orange

# Embeddings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=100
EMBEDDING_MAX_RETRIES=3

# Qdrant (self-hosted vector database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=              # Optional: only if auth enabled
QDRANT_DOCUMENTS_COLLECTION=documents
QDRANT_MEMORIES_COLLECTION=memories
QDRANT_VECTOR_SIZE=3072      # Must match embedding dimensions

# RAG settings
RAG_DEFAULT_TOP_K=5
RAG_CONTEXT_SCORE_THRESHOLD=0.5
RAG_CONVERSATION_HISTORY_MESSAGES=6

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_URL=redis://localhost:6379/2

# Job/conversation TTL
JOB_TTL_SECONDS=604800           # 7 days
CONVERSATION_TTL_SECONDS=604800  # 7 days

# Celery task settings
CELERY_TASK_TIME_LIMIT=3600      # 1 hour
CELERY_MAX_RETRIES=3
CELERY_RETRY_BASE_COUNTDOWN=60   # seconds (exponential: 60, 120, 240)

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=0.2

# Upload / async processing thresholds
ASYNC_FILE_SIZE_THRESHOLD=100000   # 100KB: files above this are processed async
ASYNC_CHUNK_COUNT_THRESHOLD=20     # chunk count above this triggers async
UPLOAD_MAX_FILE_SIZE=52428800      # 50MB

# Chat file upload settings
CHAT_FILE_MAX_SIZE=10485760        # 10MB
CHAT_FILE_MAX_COUNT=5
CHAT_FILE_TTL_SECONDS=3600         # 1 hour
CHAT_FILE_CSV_MAX_ROWS=100
CHAT_FILE_PDF_MAX_PAGES=10
CHAT_FILE_TEXT_MAX_CHARS=50000

# Dataset upload settings
DATASET_MAX_FILE_SIZE=52428800     # 50MB
DATASET_MAX_ROWS=500000

# DigitalOcean Spaces (S3-compatible object storage)
DO_SPACES_BUCKET=ai365
DO_SPACES_BASE_PATH=bingo/dev      # Override per environment
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_KEY_ID=                  # Optional: required for uploads
DO_SPACES_SECRET_KEY=              # Optional: required for uploads

# Server settings
APP_VERSION=0.1.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Logging
LOG_LEVEL=INFO

# Query guardrails
MAX_QUERY_ROWS=5000
QUERY_TIMEOUT_MS=30000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# GA4 product analytics (frontend). Empty = tracking disabled (default).
# Static/production frontend builds bake this in at BUILD time — changing it
# requires rebuilding the frontend image, not just restarting the container.
NUXT_PUBLIC_GA4_ID=

# Schema Storage
SCHEMAS_DIR=data/schemas

# Data Platform (Phase 1+)
# Local plane root: must be writable by the backend + workers; reuse the
# /app/data bind mount in dev so backend and celery-worker see the same files.
DATA_PLANE_LOCAL_ROOT=/app/data/data_plane
# dbt project synth root: same mount so artifacts survive container restarts
# and are inspectable on the host at bingo/data/dbt_projects/.
DBT_PROJECTS_ROOT=/app/data/dbt_projects

# Data-plane lockdown: when true, the LocalFilesystemDataPlane is disabled and
# any org without its own GCP service-account row falls back to Bingo's
# internal GCP project. Set true in production; leave false for dev.
DISABLE_LOCAL_DATA_PLANE=false

# Internal Bingo-managed GCP (used when DISABLE_LOCAL_DATA_PLANE=true and the
# org has no `data_planes` row of type 'google_cloud_project').
#   - Project / dataset / bucket are shared across all internal-fallback orgs.
#   - Per-org isolation is handled by BigQueryGCSPlane via scope-prefixed BQ
#     table names and GCS object keys.
#   - The service-account JSON is mounted as a file by infra (k8s Secret,
#     Docker secret, etc.); never paste the JSON into env directly.
INTERNAL_GCP_PROJECT=
INTERNAL_GCS_BUCKET=
INTERNAL_BQ_DATASET=
INTERNAL_GCP_SA_JSON_PATH=

# Feature flags
ENABLE_GOVERNANCE=false      # Set to false to disable org/team/policy enforcement

# LLM data-privacy floor. true (default): never send real cell values (sample
# rows, top values, min/max) to the LLM for ANY org — overrides the per-Org
# metadata_only_llm flag. false: defer to each Org's flag (default off = shared).
LLM_METADATA_ONLY=true

# data_agent EDA soft budget: max execute_query calls per run before the
# loop_detector injects a "summarize now" SystemMessage. Steers open-ended
# "analyze this dataset" requests toward profile_table (one call) instead of a
# long execute_query loop. Empty/unset → 5.
DATA_AGENT_QUERY_BUDGET=5

# Scope a dashboard with the user before building it. When true (default), the
# orchestrator asks about any of audience/purpose, grain, time range and priority
# metrics the request hasn't already settled, then passes the answers to
# create_dashboard as eda_findings. Set false to restore the previous
# build-immediately behaviour — no migration needed. The one-round cap inside
# ask_user_question stays active either way.
DASHBOARD_SCOPING_QUESTIONS=true

# Connector type_ids to hide from the connection picker (comma-separated)
HIDDEN_CONNECTOR_TYPES=data_plane

# === Connector → DataPlane materialization (Phase 1) ===
# Bootstrap (first) ingest pulls the last N days for incremental tables on
# connection-create. Full-snapshot tables (no detected watermark) ignore this
# and load everything. Manual "Load history" runs override via the
# /api/pipelines/{id}/load-history endpoint.
FIRST_INGEST_LOOKBACK_DAYS=1
# Incremental cursor upper-bound cutoff in whole days back from start-of-today
# UTC. 1 = T-1 (exclude same-day partials); 2 = T-2; 0 = include today.
INCREMENTAL_CUTOFF_DAYS=1

# Watermark classifier — picks the dlt incremental cursor column per source
# table. Empty model = deterministic ranked matcher only (type-first +
# name-token rank). Setting both enables the LLM-first batched classifier
# with deterministic fallback on low-confidence / errors.
WATERMARK_CLASSIFIER_MODEL=
WATERMARK_CLASSIFIER_PROVIDER=

DO_SPACES_BUCKET=thebingo
DO_SPACES_BASE_PATH=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_KEY_ID=
DO_SPACES_SECRET_KEY=

# === Optional: Async Processing Thresholds ===
ASYNC_FILE_SIZE_THRESHOLD=
ASYNC_CHUNK_COUNT_THRESHOLD=

DB_ENCRYPTION_KEY=
BINGO_ENCRYPTION_KEY=
